#version 420 core

in vec4 position;
in vec2 texcoord0;
in vec3 normal;
// Uncomment the following two ifdefs if editor performance bogs down, since it doesn't handle instanced materials well.
// #ifndef EDITOR
in mat4 mtx_world;
// #endif

uniform model_vp {
	// #ifdef EDITOR
	// mat4 mtx_world;
	// #endif
	mat4 mtx_view;
	mat4 mtx_proj;
	mat4 mtx_view_inv;
	vec4 params;
};

out vec3 var_frag_pos;
out vec3 var_normal;
out vec2 var_texcoord0;
out mat3 var_tbn;

float y_constraint_factor = params.x;
bool ignore_z_rotation = bool(params.y);

vec2 apply_roll(vec2 v) {
	if (ignore_z_rotation) {
		return v;
	}
	float roll = atan(mtx_world[1][0], mtx_world[0][0]);
	float cos_roll = cos(roll);
	float sin_roll = sin(roll);
	float rolled_x = v.x * cos_roll - v.y * sin_roll;
	float rolled_y = v.x * sin_roll + v.y * cos_roll;
	return vec2(rolled_x, rolled_y);
}

void main() {

	mat3 mtx_view3 = mat3(mtx_view);
	mat4 mtx_worldview = mtx_view * mtx_world;
	vec3 center = (mtx_world * vec4(0, 0, 0, 1)).xyz;

	vec3 scale = vec3(length(mtx_worldview[0]), length(mtx_worldview[1]), length(mtx_worldview[2]));
	vec2 rolled = apply_roll(position.xy);

	vec3 cam_R = mtx_view_inv[0].xyz;
	vec3 cam_U = mix(mtx_view_inv[1].xyz, vec3(0, 1, 0), y_constraint_factor);
	vec3 cam_F = mtx_view_inv[2].xyz;

	vec3 position_w = center + rolled.x * cam_R * scale.x + rolled.y * cam_U * scale.y + position.z * cam_F * scale.z;

	// We have 2 plausible options for the normal: a vector pointing at the view plane, or a vector pointing at the
	// camera origin. The former prevents the normal from changing when the camera is merely translated, and the latter
	// prevents the normal from changing when the camera is merely rotated. Since it seems far more distracting to have
	// the normals (and hence lighting) change while merely standing in place and looking around, we'll go with the
	// second option. The drawback of having the normals shift while strafing around should be somewhat mitigated by
	// having good normal maps.
	vec3 N = normalize(-(mtx_view * vec4(center, 1.0)).xyz);
	// construct a tangent frame by billboarding a local-right vector and crossing with the normal
	vec2 rolled_T = apply_roll(vec2(1, 0));
	vec3 T = rolled_T.x * cam_R + rolled_T.y * cam_U; // orient in world space
	T = normalize(mtx_view3 * T);
	T = normalize(T - dot(T, N) * N);
	vec3 B = cross(N, T);
	var_tbn = mat3(T, B, N);

	var_frag_pos = (mtx_view * vec4(position_w, 1.0)).xyz;
	var_normal = N;
	var_texcoord0 = texcoord0;

	gl_Position = mtx_proj * vec4(var_frag_pos, 1.0);
}
