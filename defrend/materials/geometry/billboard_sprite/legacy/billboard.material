name: "billboard"
tags: "billboard"
vertex_program: "/defrend/materials/geometry/billboard_sprite/legacy/billboard.vp"
fragment_program: "/defrend/materials/geometry/billboard_sprite/legacy/billboard_sprite.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants {
  name: "mtx_proj"
  type: CONSTANT_TYPE_PROJECTION
}
vertex_constants {
  name: "mtx_view"
  type: CONSTANT_TYPE_VIEW
}
vertex_constants {
  name: "mtx_world"
  type: CONSTANT_TYPE_WORLD
}
vertex_constants {
  name: "mtx_view_inv"
  type: CONSTANT_TYPE_VIEW_INVERSE
}
vertex_constants {
  name: "params"
  type: CONSTANT_TYPE_USER
  value {
    x: 0.5
  }
}
samplers {
  name: "albedo_map"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
  max_anisotropy: 0.0
}
samplers {
  name: "normal_map"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
  max_anisotropy: 0.0
}
samplers {
  name: "spec_glow_map"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
  max_anisotropy: 0.0
}
attributes {
  name: "mtx_world"
  semantic_type: SEMANTIC_TYPE_WORLD_MATRIX
  step_function: VERTEX_STEP_FUNCTION_INSTANCE
  vector_type: VECTOR_TYPE_MAT4
}
