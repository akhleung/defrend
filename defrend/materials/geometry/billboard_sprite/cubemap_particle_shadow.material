name: "cubemap-particle-shadow"
tags: "particle"
vertex_program: "/defrend/materials/geometry/billboard_sprite/particle_shadow.vp"
fragment_program: "/defrend/materials/geometry/billboard_sprite/cubemap_particle_shadow.fp"
vertex_constants {
  name: "mtx_proj"
  type: CONSTANT_TYPE_PROJECTION
}
vertex_constants {
  name: "mtx_view"
  type: CONSTANT_TYPE_VIEW
}
vertex_constants {
  name: "mtx_view_inv"
  type: CONSTANT_TYPE_VIEW_INVERSE
}
vertex_constants {
  name: "params"
  type: CONSTANT_TYPE_USER
  value {
    y: 1.0
  }
}
fragment_constants {
  name: "spec_glow_dith"
  type: CONSTANT_TYPE_USER
  value {
  }
}
samplers {
  name: "albedo_map"
  wrap_u: WRAP_MODE_REPEAT
  wrap_v: WRAP_MODE_REPEAT
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
  max_anisotropy: 0.0
}
attributes {
  name: "position"
  semantic_type: SEMANTIC_TYPE_POSITION
}
attributes {
  name: "mtx_world"
  semantic_type: SEMANTIC_TYPE_WORLD_MATRIX
  coordinate_space: COORDINATE_SPACE_WORLD
  vector_type: VECTOR_TYPE_MAT4
}
