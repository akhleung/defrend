#version 420 core

in vec4 position;
in vec3 normal;
in vec4 tangent;
in vec2 texcoord0;
#ifndef EDITOR
in mat4 mtx_world;
in mat4 mtx_normal;
#endif

uniform model_vp {
    #ifdef EDITOR
    mat4 mtx_world;
    mat4 mtx_normal;
    #endif
    mat4 mtx_view;
    mat4 mtx_proj;
};

out vec3 var_frag_pos;
out vec3 var_normal;
out vec2 var_texcoord0;
out mat3 var_tbn;

void main() {
    vec4 p = mtx_view * mtx_world * vec4(position.xyz, 1.0);
    var_frag_pos = p.xyz;
    mat3 mtx_normal3 = mat3(mtx_normal);
    vec3 N = normalize(mtx_normal3 * normal);
    vec3 T;
    if (tangent.xyz == vec3(0)) {
        // if there are no tangents, create an ad-hoc tangent frame based on the orientation of the normal
        vec3 absN = abs(N.xyz);
        bool vertical = absN.y > absN.x && absN.y > absN.z;
        T = normalize(cross(N, vertical ? vec3(1, 0, 0) : vec3(0, 1, 0)));
    } else {
        T = normalize(mtx_normal3 * tangent.xyz);
        T = normalize(T - dot(T, N) * N);
    }
    vec3 B = cross(N, T) * tangent.w;
    mat3 TBN = mat3(T, B, N);
    var_normal = N;
    var_texcoord0 = texcoord0;
    var_tbn = TBN;
    gl_Position = mtx_proj * p;
}
