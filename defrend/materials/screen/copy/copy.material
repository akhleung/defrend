name: "copy"
tags: "screen"
vertex_program: "/defrend/materials/screen/screen.vp"
fragment_program: "/defrend/materials/screen/copy/copy.fp"
samplers {
  name: "input_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR_MIPMAP_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 0.0
}
