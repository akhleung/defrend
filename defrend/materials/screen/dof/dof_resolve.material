name: "dof_resolve"
tags: "screen"
vertex_program: "/defrend/materials/screen/screen.vp"
fragment_program: "/defrend/materials/screen/dof/dof_resolve.fp"
vertex_constants {
  name: "mtx_viewproj"
  type: CONSTANT_TYPE_VIEWPROJ
}
fragment_constants {
  name: "params"
  type: CONSTANT_TYPE_USER
  value {
  }
}
fragment_constants {
  name: "frustum_terms"
  type: CONSTANT_TYPE_USER
  value {
  }
}
samplers {
  name: "focused_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_NEAREST
  filter_mag: FILTER_MODE_MAG_NEAREST
  max_anisotropy: 0.0
}
samplers {
  name: "blurred_sampler"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR_MIPMAP_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
  max_anisotropy: 0.0
}
