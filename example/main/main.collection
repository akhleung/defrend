collection_instances {
  id: "defrend"
  collection: "/defrend/defrend.collection"
  instance_properties {
    id: "renderer"
    properties {
      id: "cameras"
      properties {
        id: "scene_camera_url"
        value: "/camera#camera"
        type: PROPERTY_TYPE_URL
      }
    }
  }
  instance_properties {
    id: "lighting"
    properties {
      id: "shadow"
      properties {
        id: "cascade"
        value: "0.1, 0.2, 0.3, 0.4"
        type: PROPERTY_TYPE_VECTOR4
      }
      properties {
        id: "biases"
        value: "0.1, 0.15, 0.2, 0.25"
        type: PROPERTY_TYPE_VECTOR4
      }
      properties {
        id: "light_frustum_z_padding"
        value: "2.0"
        type: PROPERTY_TYPE_NUMBER
      }
    }
    properties {
      id: "ssao"
      properties {
        id: "min_distance"
        value: "0.15"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "max_distance"
        value: "0.3"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "radius"
        value: "0.25"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "blur_radius"
        value: "3.0"
        type: PROPERTY_TYPE_NUMBER
      }
    }
    properties {
      id: "light"
      properties {
        id: "sunlight_enabled"
        value: "false"
        type: PROPERTY_TYPE_BOOLEAN
      }
      properties {
        id: "sun_url"
        value: "/sun"
        type: PROPERTY_TYPE_URL
      }
      properties {
        id: "sun_color"
        value: "1.0, 1.0, 0.92, 1.0"
        type: PROPERTY_TYPE_VECTOR4
      }
      properties {
        id: "ambient_color"
        value: "0.7, 0.7, 0.7, 1.0"
        type: PROPERTY_TYPE_VECTOR4
      }
    }
    properties {
      id: "point_light"
      properties {
        id: "shadow_bias_far"
        value: "0.6"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "pcf_samples"
        value: "4.0"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "poisson_scale"
        value: "3.0"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "hash_scale"
        value: "3.0"
        type: PROPERTY_TYPE_NUMBER
      }
      properties {
        id: "soft_penumbras"
        value: "true"
        type: PROPERTY_TYPE_BOOLEAN
      }
    }
    properties {
      id: "spot_light"
      properties {
        id: "enabled"
        value: "false"
        type: PROPERTY_TYPE_BOOLEAN
      }
    }
  }
  instance_properties {
    id: "post_processing"
    properties {
      id: "glow"
      properties {
        id: "separation"
        value: "2.0"
        type: PROPERTY_TYPE_NUMBER
      }
    }
  }
}
