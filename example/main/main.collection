    properties {
      id: "shadow_map"
      value: "/example/main/point_light_shadowmap1.render_target"
      type: PROPERTY_TYPE_HASH
    }
    properties {
      id: "shadow_bias_near"
      value: "0.1"
      type: PROPERTY_TYPE_NUMBER
    }
    properties {
      id: "shadow_bias_far"
      value: "0.6"
      type: PROPERTY_TYPE_NUMBER
    }
    properties {
      id: "pcf_samples"
      value: "4.0"
      type: PROPERTY_TYPE_NUMBER
    }
    properties {
      id: "poisson_scale"
      value: "1.5"
      type: PROPERTY_TYPE_NUMBER
    }
    properties {
      id: "hash_scale"
      value: "5.0"
      type: PROPERTY_TYPE_NUMBER
    }
  }
  scale3 {
    x: 50.0
    y: 50.0
    z: 50.0
  }
}
