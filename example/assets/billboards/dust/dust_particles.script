go.property("mtl_shadow", resource.material("/defrend/materials/geometry/billboard_sprite/particle.material"))
go.property("mtl_shadowless", resource.material("/defrend/materials/geometry/billboard_sprite/shadowless_particle.material"))

local shadow = true
function init(self)
	particlefx.play("#dust")
	particlefx.set_constant("#dust", "emitter", "spec_glow_dith", vmath.vector4(0, 0, 1, 0))

	timer.delay(5, true, function (self, handle, time_elapsed)
		if shadow then
			particlefx.stop("#dust")
			---@diagnostic disable-next-line: assign-type-mismatch
			go.set("#dust", "material", self.mtl_shadowless, { keys = { "emitter" } })
			particlefx.play("#dust")
		else
			particlefx.stop("#dust")
			---@diagnostic disable-next-line: assign-type-mismatch
			go.set("#dust", "material", self.mtl_shadow, { keys = { "emitter" } })
			particlefx.play("#dust")
		end
		shadow = not shadow
	end)
end
